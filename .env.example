# Conexão PostgreSQL (Supabase: use a connection string do "Session pooler" ou conexão direta).
# O usuário precisa ser dono das tabelas (ex.: "postgres" no Supabase) — a aplicação
# troca para o papel restrito "app_tenant" em cada transação de tenant (RLS).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/beauty_os

# URL pública da aplicação (links de agendamento, e-mails).
APP_URL=http://localhost:3000

# Fuso horário padrão para novas organizações.
DEFAULT_TIMEZONE=America/Sao_Paulo

# --- Integrações pendentes (deixe vazio até configurar) ---
# E-mail transacional (ex.: Resend/Postmark) — ainda não implementado.
EMAIL_PROVIDER_API_KEY=
# WhatsApp Business Platform via provedor oficial — ainda não implementado.
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Segredo do endpoint /api/cron/mensagens (gere um valor aleatório longo).
CRON_SECRET=
